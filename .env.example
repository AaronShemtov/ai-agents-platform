# Copy to .env for local runs. In the cluster these come from the ConfigMap and from
# OCI Vault via External Secrets — see applications/agents/ in the personal-k8s repo.

# --- which agent this process is --------------------------------------------
AGENT_PROFILE=lead
AGENTS_DIR=agents

# --- LLM: Azure AI Foundry ---------------------------------------------------
# Must be the /openai/v1/ route. The older .services.ai.azure.com/models endpoint
# (Azure AI Inference SDK) is retired.
AZURE_OPENAI_BASE_URL=https://ai-agent-support.services.ai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=
# The value here is the *deployment name* in Foundry, not a catalogue model id.
MODEL_DEFAULT=gpt-5-mini
MODEL_ALLOWLIST=gpt-5-mini

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Fail-closed: empty means nobody can talk to the bot. Message the bot once and read
# the id it prints back at you.
TELEGRAM_ALLOWED_USERS=

# --- MCP servers -------------------------------------------------------------
# Leave a URL empty to disable that server for this deployment.
MCP_GITHUB_URL=http://mcp-github.agents.svc.cluster.local:8082/
MCP_CLOUDFLARE_URL=http://mcp-cloudflare.agents.svc.cluster.local:8080/mcp
MCP_CLUSTER_URL=http://mcp-cluster.agents.svc.cluster.local:8080/mcp

# Fine-grained PAT scoped to exactly the repositories the agent may touch.
# It lives here rather than in the mcp-github pod because the official GitHub MCP
# server in http mode has no token setting and demands a per-request bearer.
GITHUB_PAT=

# --- policy ------------------------------------------------------------------
GITHUB_WRITE_MODE=direct-push
# GITHUB_WRITE_MODE=pull-request
# GITHUB_WRITE_MODE=read-only

CLOUDFLARE_WRITE_MODE=approve
# CLOUDFLARE_WRITE_MODE=auto
# CLOUDFLARE_WRITE_MODE=read-only

# Never pushed to directly, whatever the write mode says: a bad manifest here reaches
# the live cluster within ~10 minutes via Flux.
PROTECTED_REPOS=personal-k8s

# --- limits ------------------------------------------------------------------
MAX_STEPS=30
MAX_TOKENS_PER_TURN=120000

# --- process -----------------------------------------------------------------
HEALTH_PORT=8080
LOG_LEVEL=INFO

# --- mcp_cloudflare only (set in that Deployment, not the agent's) -----------
# CLOUDFLARE_API_TOKEN=
# Optional; auto-detected when the token has "Account Resources: Read".
# CLOUDFLARE_ACCOUNT_ID=
